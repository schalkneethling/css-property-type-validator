{
  "name": "css-property-type-validator",
  "version": "0.1.0",
  "private": true,
  "description": "Validate CSS custom property registrations and var() usages against @property syntax descriptors.",
  "keywords": [
    "css",
    "custom-properties",
    "property",
    "validator"
  ],
  "license": "MIT",
  "author": "Schalk Neethling",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "vp check && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:contracts",
    "check:contracts": "pnpm run acceptance:check && pnpm run spec:check && pnpm run guardrails:core && pnpm run guardrails:reads && pnpm run guardrails:diagnostics && pnpm run guardrails:generated && pnpm run guardrails:release-order && pnpm run guardrails:versions && pnpm run guardrails:determinism && pnpm run ephemeral:contract:check && pnpm run ephemeral:contract:generated-check && pnpm run web:assert-release-boundary",
    "format": "vp check --fix",
    "format:check": "vp check --no-lint",
    "lint": "vp check --no-fmt",
    "test": "vp test run",
    "test:e2e": "pnpm --filter @schalkneethling/css-property-type-validator-web test:e2e",
    "test:report:browser": "pnpm --filter @schalkneethling/css-property-type-validator-report test:browser",
    "report:ci": "node scripts/create-ci-audit-report.mjs",
    "spec:check": "packages/core/node_modules/.bin/vitest run packages/core/test/specification.test.ts",
    "spec:coverage": "pnpm run spec:check",
    "spec:links": "node scripts/check-spec-links.mjs",
    "spec:drift": "node scripts/check-spec-drift.mjs",
    "ephemeral:contract:check": "node scripts/check-ephemeral-contract.mjs",
    "ephemeral:contract:generate": "node scripts/generate-ephemeral-contract.mjs --write",
    "ephemeral:contract:generated-check": "node scripts/generate-ephemeral-contract.mjs",
    "ephemeral:contract:update": "node scripts/check-ephemeral-drift.mjs --proposal",
    "ephemeral:drift": "node scripts/check-ephemeral-drift.mjs",
    "ephemeral:canary": "node scripts/ephemeral-canary.mjs",
    "acceptance:check": "node scripts/check-acceptance-traceability.mjs",
    "guardrails:core": "node scripts/check-core-browser-boundary.mjs",
    "guardrails:reads": "node scripts/check-bounded-css-reads.mjs",
    "guardrails:diagnostics": "node scripts/check-diagnostic-code-contract.mjs",
    "guardrails:generated": "node scripts/check-generated-contracts.mjs --require",
    "guardrails:release-order": "node scripts/check-release-workflow-order.mjs",
    "guardrails:versions": "node scripts/check-version-contracts.mjs",
    "guardrails:web-published-consumer": "pnpm run web:assert-release-boundary && pnpm run web:check-published-core",
    "guardrails:ephemeral-report": "pnpm run ephemeral:contract:check && pnpm --filter @schalkneethling/css-property-type-validator-report test",
    "guardrails:report-no-network": "pnpm run test:report:browser",
    "test:guardrails": "node --test scripts/test/*.test.mjs",
    "parser:benchmark": "node scripts/benchmark-parsers.mjs",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "agent:verify:red": "node scripts/agent-verify-red.mjs",
    "agent:verify:changed": "node scripts/agent-verify-changed.mjs",
    "agent:handoff": "node scripts/agent-handoff.mjs",
    "web:assert-release-boundary": "node scripts/check-web-release-boundary.mjs",
    "web:check-published-core": "node scripts/check-web-published-core.mjs",
    "release:pack-check": "pnpm run build && node scripts/check-packed-packages.mjs",
    "release:consume-local": "pnpm run build && node scripts/check-packed-packages.mjs --consume",
    "release:verify-publication": "node scripts/verify-publication.mjs",
    "release:rehearse": "pnpm run release:consume-local && pnpm run web:assert-release-boundary && pnpm run web:check-published-core",
    "typecheck": "node node_modules/typescript/bin/tsc -b tsconfig.json",
    "release:add": "bumpy add",
    "release:status": "bumpy status",
    "release:version": "bumpy version && pnpm run release:check-changelogs",
    "release:check": "bumpy check --strict && pnpm run release:check-changelogs && pnpm run format:check",
    "release:check-changelogs": "node scripts/check-changelog-format.mjs",
    "release:verify": "pnpm run release:check-changelogs && pnpm run check && pnpm run check:supported-syntax-names",
    "check:supported-syntax-names": "node scripts/check-supported-syntax-names.mjs",
    "clean": "node scripts/clean.mjs",
    "example": "pnpm run build && node packages/cli/dist/cli.js fixtures/imports/main.css",
    "guardrails:determinism": "node scripts/check-determinism-rules.mjs scripts packages/cli/src packages/core/src packages/project-context/src packages/report/src packages/stylelint/src"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@varlock/bumpy": "1.18.1",
    "cheerio": "^1.2.0",
    "lightningcss": "1.33.0",
    "postcss": "8.5.26",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
