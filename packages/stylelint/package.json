{
  "name": "@schalkneethling/stylelint-plugin-css-property-type-validator",
  "version": "0.1.0-beta.1",
  "description": "Stylelint plugin for CSS Property Type Validator.",
  "keywords": [
    "css",
    "custom-properties",
    "property",
    "stylelint",
    "stylelint-plugin",
    "validator"
  ],
  "homepage": "https://github.com/schalkneethling/css-property-type-validator#readme",
  "bugs": {
    "url": "https://github.com/schalkneethling/css-property-type-validator/issues"
  },
  "license": "MIT",
  "author": "Schalk Neethling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schalkneethling/css-property-type-validator.git",
    "directory": "packages/stylelint"
  },
  "files": [
    "dist/index.*",
    "dist/rules/valid-property-types.d.ts",
    "dist/rules/valid-property-types.d.ts.map",
    "dist/rules/valid-property-types.js",
    "dist/rules/valid-property-types.js.map",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@schalkneethling/css-property-type-validator-core": "workspace:*"
  },
  "devDependencies": {
    "stylelint": "^17.12.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  }
}
