{
  "name": "@schalkneethling/css-property-type-validator-cli",
  "version": "0.8.0",
  "description": "CLI for CSS custom property type validator.",
  "keywords": [
    "cli",
    "css",
    "custom-properties",
    "property",
    "validator"
  ],
  "homepage": "https://github.com/schalkneethling/css-property-type-validator#readme",
  "bugs": {
    "url": "https://github.com/schalkneethling/css-property-type-validator/issues"
  },
  "license": "MIT",
  "author": "Schalk Neethling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schalkneethling/css-property-type-validator.git",
    "directory": "packages/cli"
  },
  "bin": {
    "css-property-type-validator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/check-private-bundle.mjs",
    "test:package-boundary": "node scripts/check-private-bundle.mjs",
    "test": "vp test run --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@schalkneethling/css-property-type-validator-core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@schalkneethling/css-property-type-validator-project-context": "workspace:*",
    "@schalkneethling/css-property-type-validator-report": "workspace:*",
    "vite-plus": "^0.1.24",
    "vitest": "^4.1.10"
  }
}
